pipeline {
  agent none

  options {
    skipDefaultCheckout(true)
    timestamps()
    disableConcurrentBuilds()
    // One shared lock across CI, commit, PR, nightly and monster jobs.
    // agent none keeps lock waiters off both VM executors.
    lock(resource: 'rlucene-vm-build')
    buildDiscarder(logRotator(numToKeepStr: '200'))
  }

  triggers {
    // The shared Pipeline must not automatically schedule monster tests.
    cron(env.JOB_NAME == 'rlucene-nightly' ? 'TZ=Asia/Shanghai\nH */2 * * *' : '')
  }

  stages {
    stage('Exclusive VM build') {
      agent { label 'built-in' }
      options {
        // Lock waiting is outside the execution timeout.
        // Heavy tests can legitimately take hours; retain their 72h budget.
        timeout(time: 72, unit: 'HOURS')
      }

      environment {
        RUSTUP_HOME = '/opt/rustup'
        CARGO_HOME = '/opt/cargo'
        CARGO_TARGET_DIR = "${JENKINS_HOME}/cargo-target/${JOB_NAME}"
        CARGO_PROFILE_RELEASE_DEBUG_ASSERTIONS = 'true'
        CARGO_TERM_COLOR = 'never'
        CARGO_NET_RETRY = '10'
        CARGO_HTTP_TIMEOUT = '120'
        CARGO_HTTP_MULTIPLEXING = 'false'
        RUST_BACKTRACE = 'full'
        NO_COLOR = '1'
      }

      stages {
        stage('Build request') {
          steps {
            script {
              if (!(env.JOB_NAME in ['rlucene-nightly', 'rlucene-monster'])) {
                error('This Pipeline belongs to rlucene-nightly or rlucene-monster.')
              }
              def manualRequest = !currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').isEmpty()
              def scheduledNightly = env.JOB_NAME == 'rlucene-nightly' &&
                !currentBuild.getBuildCauses('hudson.triggers.TimerTrigger$TimerTriggerCause').isEmpty()
              if (!manualRequest && !scheduledNightly) {
                error('This job requires a manual request, or a nightly timer trigger.')
              }
              env.HEAVY_SUITE = env.JOB_NAME.substring('rlucene-'.length())
              if (!env.WORKSPACE_TMP) {
                error('WORKSPACE_TMP is unavailable')
              }
              env.TMPDIR = "${env.WORKSPACE_TMP}/manual-tests-${env.BUILD_NUMBER}"
              currentBuild.keepLog = true
              currentBuild.description = "${manualRequest ? 'manual' : 'scheduled'} release: ${env.HEAVY_SUITE} only"
            }
          }
        }

        stage('Checkout') {
          steps {
            checkout(scm)
            script {
              env.TESTED_SHA = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
              currentBuild.description = "${env.TESTED_SHA.take(12)}: ${env.HEAVY_SUITE} only (release)"
            }
            sh '''#!/bin/bash
              set -euo pipefail
              mkdir -p "$TMPDIR" "$CARGO_TARGET_DIR"
              df -h . /tmp "$CARGO_TARGET_DIR"
              du -sh "$CARGO_TARGET_DIR"
              git diff --exit-code
              rustup show
              cargo nextest --version
              jq --version
            '''
          }
        }

        stage('Release feature-exclusive tests') {
          steps {
            sh '''#!/bin/bash
              set -euo pipefail
              bash ci/jenkins/manual/run-tests.sh "$HEAVY_SUITE"
            '''
          }
        }
      }

      post {
        always {
          archiveArtifacts(
            artifacts: 'manual-tests.log,manual-junit.xml,manual-selection.txt',
            allowEmptyArchive: true
          )
          sh '''#!/bin/bash
            set -eu
            df -h /var/jenkins_home /tmp
            if [ -d "$CARGO_TARGET_DIR" ]; then du -sh "$CARGO_TARGET_DIR"; fi
            expected="${WORKSPACE_TMP}/manual-tests-${BUILD_NUMBER}"
            if [ "${TMPDIR:-}" = "$expected" ] && [ -d "$expected" ]; then
              rm -rf -- "$expected"
            fi
          '''
        }
        failure {
          script {
            if (env.RLUCENE_FAILURE_EMAIL?.trim()) {
              emailext(
                to: env.RLUCENE_FAILURE_EMAIL,
                subject: "[Jenkins] ${env.JOB_NAME} #${env.BUILD_NUMBER} failed",
                body: "Build: ${env.BUILD_URL}\nCommit: ${env.TESTED_SHA}\nSuite: ${env.HEAVY_SUITE} only (release)\n",
                attachLog: true,
                compressLog: true,
                attachmentsPattern: 'manual-tests.log,manual-selection.txt'
              )
            }
          }
        }
      }
    }
  }
}
