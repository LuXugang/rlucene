pipeline {
  agent { label 'rlucene-pr' }

  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timeout(time: 35, unit: 'MINUTES')
    timestamps()
  }

  environment {
    CARGO_HOME = '/opt/cargo'
    RUSTUP_HOME = '/opt/rustup'
    CARGO_TARGET_DIR = '/home/rlucene/cargo-target/rlucene-commit'
  }

  stages {
    stage('Authorize request') {
      steps {
        script {
          currentBuild.keepLog = true
          if (!(params.COMMIT_SHA ==~ /[0-9a-f]{40}/)) {
            error('COMMIT_SHA is invalid')
          }
          currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.COMMIT_SHA.take(12)}"
          currentBuild.description = "main · ${params.COMMIT_SHA}"
          env.TRUSTED_COMMIT_SHA = params.COMMIT_SHA
          env.BUILD_TMPDIR = "${env.WORKSPACE_TMP}/rlucene-commit-build-tmp/${env.BUILD_NUMBER}"
        }
      }
    }

    stage('Checkout exact main revision') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: env.TRUSTED_COMMIT_SHA]],
          doGenerateSubmoduleConfigurations: false,
          extensions: [
            [$class: 'CleanBeforeCheckout', deleteUntrackedNestedRepositories: true],
            [$class: 'CloneOption', depth: 1, honorRefspec: true, noTags: true, shallow: true, timeout: 10]
          ],
          submoduleCfg: [],
          userRemoteConfigs: [[
            credentialsId: 'github-ssh',
            name: 'origin',
            refspec: "+${env.TRUSTED_COMMIT_SHA}:refs/remotes/origin/requested-commit",
            url: 'git@github.com:Rustify-All/rlucene.git'
          ]]
        ])
        sh '''
          set -eu
          actual_sha="$(git rev-parse HEAD)"
          test "${actual_sha}" = "${TRUSTED_COMMIT_SHA}"
          printf 'Checked out main update at %s\n' "${actual_sha}"
        '''
      }
    }

    stage('cargo test-light') {
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          sh '''#!/usr/bin/env bash
            set -eu
            mkdir -p "${BUILD_TMPDIR}" "${CARGO_TARGET_DIR}"
            export TMPDIR="${BUILD_TMPDIR}"
            set -o pipefail
            cargo test-light 2>&1 | tee cargo-test-light.log
          '''
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'cargo-test-light.log', allowEmptyArchive: true
      sh '''
        if test -n "${BUILD_TMPDIR:-}"; then
          rm -rf -- "${BUILD_TMPDIR}"
        fi
      '''
      deleteDir()
    }
  }
}
