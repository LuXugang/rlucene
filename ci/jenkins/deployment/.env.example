# Copy to .env in this directory. No passwords or private keys belong here.
COMPOSE_PROJECT_NAME=rlucene-jenkins
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_IMAGE=local-jenkins-rust:2.568.3
JENKINS_BASE_IMAGE=jenkins/jenkins:2.568.3-jdk21@sha256:c1e4c349365f6d16d88595b2c5f7e8ff39b8ae1d061f62420bac193b4b9616d0
JAVA_OPTS=-Xms2g -Xmx8g
TZ=Asia/Shanghai
# The official image only replaces older plugins in an existing Jenkins home
# when these values are non-empty. The second setting handles installations
# created by an older image that did not record image-version markers.
PLUGINS_FORCE_UPGRADE=true
TRY_UPGRADE_IF_NO_MARKER=true

# A public HTTPS checkout needs no Git credential. Change this URL for a fork.
RLUCENE_REPOSITORY_URL=https://github.com/Rustify-All/rlucene.git
RLUCENE_BRANCH=main
RLUCENE_GIT_CREDENTIALS_ID=
RLUCENE_JOB_NAME=rlucene-ci
RLUCENE_JOB_DISABLED=false
# Optional public access. Complete the setup wizard first, then list every
# administrator user ID and restart Jenkins.
RLUCENE_PUBLIC_READ_ONLY=false
RLUCENE_ADMIN_USERS=
# Optional: configure SMTP in Jenkins before setting a recipient.
RLUCENE_FAILURE_EMAIL=

# Optional download mirrors, used when building the image:
# DEBIAN_MIRROR=https://deb.debian.org/debian
# DEBIAN_SECURITY_MIRROR=https://deb.debian.org/debian-security
# RUSTUP_DIST_SERVER=https://static.rust-lang.org
# RUSTUP_UPDATE_ROOT=https://static.rust-lang.org/rustup
# CARGO_REGISTRY=sparse+https://index.crates.io/
