import hudson.model.Item
import hudson.model.User
import hudson.security.AuthorizationMatrixProperty
import hudson.security.HudsonPrivateSecurityRealm
import hudson.security.ProjectMatrixAuthorizationStrategy
import java.nio.file.Files
import java.nio.file.attribute.PosixFilePermissions
import java.util.UUID
import jenkins.model.Jenkins
import jenkins.security.ApiTokenProperty
import org.jenkinsci.plugins.matrixauth.PermissionEntry

def setting = { String name, String fallback ->
  System.getenv(name) ?: fallback
}
def jenkins = Jenkins.get()
def realm = jenkins.getSecurityRealm()
if (!(realm instanceof HudsonPrivateSecurityRealm)) {
  println('Deferring RLucene PR trigger account until the Jenkins private security realm is configured')
  return
}
def strategy = jenkins.getAuthorizationStrategy()
if (!(strategy instanceof ProjectMatrixAuthorizationStrategy)) {
  println('Deferring RLucene PR trigger account until Project Matrix Authorization Strategy is configured')
  return
}
def triggerUser = setting('RLUCENE_PR_TRIGGER_USER', 'rlucene-github')
if (!(triggerUser ==~ /[A-Za-z0-9][A-Za-z0-9_.@-]*/)) {
  throw new IllegalArgumentException('RLUCENE_PR_TRIGGER_USER must be a simple Jenkins user ID')
}

def user = User.getById(triggerUser, false)
if (user == null) {
  realm.createAccount(triggerUser, UUID.randomUUID().toString())
  user = User.getById(triggerUser, false)
  println("Created dedicated Jenkins user ${triggerUser}")
}
def tokenProperty = user.getProperty(ApiTokenProperty.class)
if (tokenProperty == null) {
  tokenProperty = new ApiTokenProperty()
  user.addProperty(tokenProperty)
}
def tokenName = 'github-pr-router'
def existingToken = tokenProperty.getTokenStore().getTokenListSortedByName().find {
  it.getName() == tokenName
}
if (existingToken == null) {
  def generatedToken = tokenProperty.generateNewToken(tokenName)
  def bootstrapFile = new File(
    jenkins.getRootDir(),
    'secrets/rlucene-pr-trigger-token'
  )
  Files.writeString(bootstrapFile.toPath(), generatedToken.plainValue)
  Files.setPosixFilePermissions(
    bootstrapFile.toPath(),
    PosixFilePermissions.fromString('rw-------')
  )
  println(
    'Created the one-time RLucene PR trigger token file; ' +
      'copy it to GitHub Actions secrets, then delete the plaintext file'
  )
}
user.save()

strategy.add(Jenkins.READ, PermissionEntry.user(triggerUser))
jenkins.setAuthorizationStrategy(strategy)

def jobName = setting('RLUCENE_PR_JOB_NAME', 'rlucene-pr')
def job = jenkins.getItem(jobName)
if (job == null) {
  throw new IllegalStateException("Jenkins job ${jobName} does not exist")
}
def jobAuthorization = job.getProperty(AuthorizationMatrixProperty.class)
if (jobAuthorization == null) {
  def permissions = [
    (Item.READ): ([PermissionEntry.user(triggerUser)] as Set),
    (Item.BUILD): ([PermissionEntry.user(triggerUser)] as Set),
    (Item.CANCEL): ([PermissionEntry.user(triggerUser)] as Set)
  ]
  job.addProperty(new AuthorizationMatrixProperty(
    permissions,
    new org.jenkinsci.plugins.matrixauth.inheritance.InheritParentStrategy()
  ))
} else {
  jobAuthorization.add(Item.READ, PermissionEntry.user(triggerUser))
  jobAuthorization.add(Item.BUILD, PermissionEntry.user(triggerUser))
  jobAuthorization.add(Item.CANCEL, PermissionEntry.user(triggerUser))
}
job.save()
jenkins.save()
println("Configured dedicated trigger access for Jenkins job ${jobName}")
