import hudson.model.queue.QueueTaskDispatcher

// Keep this override file to replace the old hook in persistent Jenkins homes.
// Deleting it from Git would leave the previously copied .groovy file active.
// A Pipeline waiting for the global lock is already a running Job; the old
// one-way idle gate must not participate in global-lock scheduling.
def dispatchers = QueueTaskDispatcher.all()
def obsolete = dispatchers.findAll {
  it.class.name == 'RluceneCiIdleQueueDispatcher'
}
dispatchers.removeAll(obsolete)
println('Retired the CI-only idle queue gate; Pipelines use rlucene-vm-build.')
